# TRINETRA Backend Configuration Environment Variables

# Initial admin password used to seed the admin account on first startup
TRINETRA_ADMIN_PASSWORD=

# JWT Secret Key used for signing tokens (HS256)
JWT_SECRET_KEY=trinetra-soc-super-secret-jwt-signing-key-change-in-production

# Server Host & Port
HOST=0.0.0.0
PORT=8000
